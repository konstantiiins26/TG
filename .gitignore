.env
__pycache__/
*.pyc
.venv/
venv/

# Состояние бота и записи рынка — не в репозиторий
*.db
*.jsonl
# Спутники базы в режиме WAL: под маску *.db они НЕ попадают
*.db-wal
*.db-shm

# Состояние рантайма
sniper_state.db
wallet.key

# Ключи пользователя. Лежат рядом с запускалкой, но в git НЕ попадают:
# файл в репозитории, куда вписывают токен, git pull либо отказывается
# обновлять, либо затирает — и ключ тихо пропадает.
deploy/my-secrets.bat
deploy/my-secrets.sh

# Otchet rezhima --flip: rezultat progona, ne ishodnik
flip-report.txt
# Отчёты бот пишет САМ через --log-file (arb.bat, mrkt.bat, go.bat).
# Отслеживаемый файл, который бот перезаписывает, ломается на первом
# же `git pull` — это уже было с ключами в start-windows.bat.
*-report.txt
bot-log.txt
model_colors.json
seetg-frames.jsonl
