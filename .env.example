# Скопируйте в .env (или экспортируйте в окружение) и впишите свои значения.
# НИКОГДА не коммитьте настоящий .env с реальными ключами в git!

# --- Обязательно ---
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Коллекции через запятую. У Telegram Gifts каждый тип подарка — ОТДЕЛЬНЫЙ
# контракт со своим floor; одного адреса "на все подарки" не существует.
# Адрес берётся из URL коллекции на getgems.io/collection/EQ...
#
# НАГРУЗКА растёт линейно: коллекции x FLOOR_SAMPLE_PAGES x (60/POLL_INTERVAL_SEC)
# запросов в минуту. 10 коллекций при интервале 12с = 250 req/min = гарантированный
# 429. Для широкого охвата поднимайте POLL_INTERVAL_SEC до 60.
TARGET_COLLECTIONS=EQ...первая...,EQ...вторая...

# --- Желательно (выше лимиты рыночного API) ---
TONAPI_KEY=

# --- Используется ТОЛЬКО заглушкой покупки (реальная подпись не выполняется) ---
WALLET_PRIVATE_KEY=

# --- Модель ИИ (по умолчанию актуальная claude-sonnet-5) ---
CLAUDE_MODEL=claude-sonnet-5

# --- Верификация коллекции (защита от скам-клонов) ---
# Адреса доверенных коллекций через запятую (raw или EQ.../UQ... — любая форма).
# ПУСТО = проверка ОТКЛЮЧЕНА. Заполните перед реальной торговлей.
COLLECTION_WHITELIST=

# --- Экономика сделки ---
# Комиссия и роялти берутся С ЦЕНЫ ПРОДАЖИ (так работают площадки).
MARKETPLACE_FEE_PCT=0.05
ROYALTY_PCT=0.05
UNDERCUT_PCT=0.03
GAS_FEE_TON=0.15
MIN_ROI_PCT=5

# --- Расчёт Floor Price (выборкой, т.к. у API нет сортировки по цене) ---
FLOOR_PAGE_SIZE=100
FLOOR_SAMPLE_PAGES=5
FLOOR_PERCENTILE=5
MIN_FLOOR_SAMPLE=40

# Пауза между запросами к TonAPI. Без ключа лимит считается ПО СЕКУНДАМ,
# поэтому 15 страниц подряд ловят 429 даже при редком опросе. С ключом
# TONAPI_KEY паузу можно снизить.
TONAPI_MIN_INTERVAL=1.1
TONAPI_MAX_RETRIES=3
FLOOR_CACHE_TTL_SEC=60
CANDIDATES_TO_ANALYZE=5

# --- Редкость трейтов (Ярус 2) ---
# Редкость оценивается по той же выборке, что и floor (официального API нет).
RARE_TRAIT_THRESHOLD_PCT=5
MIN_TRAIT_SAMPLE=50

# --- Ликвидность (Ярус 2) ---
COMPETITION_BAND_PCT=10
MAX_COMPETITION=15

# История продаж: эндпоинт НЕ проверен из среды разработки, поэтому выключен.
# Включайте (=1) только убедившись, что ответ реально парсится.
ENABLE_SALES_HISTORY=0
LIQUIDITY_WINDOW_HOURS=72
MIN_SALES_IN_WINDOW=1

# --- Дедупликация (Ярус 2) ---
# Не переспрашивать ИИ про тот же лот по той же цене N секунд (экономия на API).
SEEN_TTL_SEC=300

# --- Риск-лимиты (Ярус 3) ---
# Хранятся в БД, поэтому перезапуск бота их НЕ сбрасывает.
MAX_SPEND_PER_TRADE_TON=50
MAX_SPEND_PER_HOUR_TON=200
MAX_SPEND_PER_DAY_TON=1000
MAX_OPEN_POSITIONS=10
STOP_AFTER_LOSSES=3

# --- Хранилище состояния (Ярус 3) ---
DB_PATH=sniper_state.db

# --- Уведомления в Telegram (Ярус 3, необязательно) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Запись рынка и бэктест (Ярус 3) ---
RECORD_PATH=market_history.jsonl
BACKTEST_HOLD_HOURS=24

# --- Премия за красивый номер / редкость ---
# 1.0 = премии нет (по умолчанию). Любое значение выше 1.0 ЗАВЫШАЕТ расчётную
# прибыль — поднимайте только после калибровки по своей записи (--backtest).
PREMIUM_MULT=1.0

# --- БАНКРОЛЛ (Ярус 4) ---
# Сумма, которой боту разрешено оперировать. Деньги лежат на ВАШЕМ кошельке.
# 0 = банк не задан, живая торговля запрещена. См. SETUP.md.
BANKROLL_TON=0
RESERVE_TON=5              # неснижаемый остаток на газ, не тратится никогда
MAX_POSITION_PCT=10        # максимум % банка в одной сделке

# --- КОШЕЛЁК (Ярус 4) ---
# Путь к файлу с приватным ключом. ФАЙЛ, а не переменная: env видно в `ps`.
# Права обязаны быть 0600, иначе бот откажется стартовать.
# НИКОГДА не присылайте этот ключ в чат — ни мне, ни кому-либо.
WALLET_KEY_FILE=

TRADING_NETWORK=testnet    # testnet | mainnet. Начинайте с testnet.

# Осознанный speed bump: без точной строки живая торговля не запустится.
CONFIRM_LIVE_TRADING=

# --- Цикл мониторинга ---
# Внимание: за цикл уходит FLOOR_SAMPLE_PAGES запросов. Ловите 429 —
# поднимайте POLL_INTERVAL_SEC или снижайте FLOOR_SAMPLE_PAGES.
POLL_INTERVAL_SEC=12
HTTP_TIMEOUT_SEC=15

# 1 = безопасный режим (только заглушка покупки). 0 = попытка реальной покупки (не реализована).
DRY_RUN=1
