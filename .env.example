# Скопируйте в .env (или экспортируйте в окружение) и впишите свои значения.
# НИКОГДА не коммитьте настоящий .env с реальными ключами в git!

# --- Обязательно ---
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxx
TARGET_COLLECTION=EQ...адрес_коллекции_подарков...

# --- Желательно (выше лимиты рыночного API) ---
TONAPI_KEY=

# --- Используется ТОЛЬКО заглушкой покупки (реальная подпись не выполняется) ---
WALLET_PRIVATE_KEY=

# --- Модель ИИ (по умолчанию актуальная claude-sonnet-5) ---
CLAUDE_MODEL=claude-sonnet-5

# --- Экономика сделки ---
MARKETPLACE_FEE_PCT=0.05
GAS_FEE_TON=0.15
MIN_ROI_PCT=5

# --- Цикл мониторинга ---
POLL_INTERVAL_SEC=12
ITEMS_PER_POLL=20
HTTP_TIMEOUT_SEC=15

# 1 = безопасный режим (только заглушка покупки). 0 = попытка реальной покупки (не реализована).
DRY_RUN=1
